# --- LLM 配置（研报生成的模型后端，兼容 OpenAI 接口） ---
# 可用任意 OpenAI 兼容端点，如 DeepSeek / 通义 / 智谱 / OpenAI
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=deepseek-chat

# --- 行情数据源 ---
# akshare 免费无需 key；若使用 tushare pro 可填 token 启用更全数据
TUSHARE_TOKEN=
